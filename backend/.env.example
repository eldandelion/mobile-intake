# ==========================================
# Alibaba Cloud SMS Configuration (.env)
# Copy this file to .env and fill in your values
# ==========================================

# 1. Enable real SMS dispatch
ALIYUN_SMS_ENABLED=true

# 2. Provider: "dypns" (Personal zero-qualification) or "dysms" (Traditional / Test signature)
ALIBABA_SMS_PROVIDER=dypns

# 3. Your RAM User AccessKey
ALIBABA_SMS_ACCESS_KEY_ID=LTAI5txxxxxxxxxxxxxxxx
ALIBABA_SMS_ACCESS_KEY_SECRET=your_actual_ram_access_key_secret

# 4. If provider=dypns (Alibaba Cloud Number Verification Scheme Code, starts with FC):
ALIBABA_SMS_SCHEME_CODE=FC1000000000000123

# 5. If provider=dysms (Traditional SMS / Test signature):
# ALIBABA_SMS_SIGN_NAME=阿里云短信测试
# ALIBABA_SMS_TEMPLATE_CODE=SMS_154950909
