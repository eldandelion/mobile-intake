# ==============================================================================
# Mobile Intake System - Environment Configuration Template
# ==============================================================================

# Server Ports
FRONTEND_PORT=3005
BACKEND_PORT=8085

# Database Configuration (inside Docker)
SPRING_DATASOURCE_URL=jdbc:sqlite:/app/data/intake.db

# Security & Secrets
INTAKE_SECURITY_JWT_SECRET=medical-system-intake-secret-key-must-be-long-enough-32bytes
INTAKE_SECURITY_ADMIN_SECRET=csu-medical-intake-admin-secret-2026

# Alibaba Cloud SMS Gateway (Optional - defaults to mock if disabled)
ALIYUN_SMS_ENABLED=false
ALIBABA_SMS_PROVIDER=dysms
ALIBABA_SMS_ACCESS_KEY_ID=
ALIBABA_SMS_ACCESS_KEY_SECRET=
ALIBABA_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIBABA_SMS_SIGN_NAME=
ALIBABA_SMS_TEMPLATE_CODE=
ALIBABA_SMS_SCHEME_CODE=
